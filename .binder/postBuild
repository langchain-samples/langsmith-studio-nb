#!/usr/bin/env bash
# Let JupyterLab see dotfiles, so a reader on Binder can make the .env the example
# notebook asks for. Both settings matter, and both default to off. Without the
# server one, Jupyter refuses to serve hidden paths at all and rejects a rename to
# ".env" with a 400. Without the front-end one, the file browser hides what it
# could otherwise fetch. Binder only. This configures the image, never the repo.
set -euo pipefail

mkdir -p "${HOME}/.jupyter"
echo 'c.ContentsManager.allow_hidden = True' >> "${HOME}/.jupyter/jupyter_server_config.py"

settings="${HOME}/.jupyter/lab/user-settings/@jupyterlab/filebrowser-extension"
mkdir -p "${settings}"
echo '{ "showHiddenFiles": true }' > "${settings}/browser.jupyterlab-settings"
